use test;
create table t(embedding VECTOR);
insert into t values ('[1,2,3]');
insert into t values ('[1,2,3,4]');
-- error 1105
alter table t modify column embedding VECTOR(3);
delete from t where vec_dims(embedding) != 3;
alter table t modify column embedding VECTOR(3);
